# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# Kanal manzili. Ochiq kanal bo'lsa: @mening_kanalim
# Yopiq kanal bo'lsa raqamli ID: -1001234567890
CHANNEL_ID=@mening_kanalim

# Botdan kim foydalana olishi. O'z Telegram ID raqamingiz.
# Bir nechta bo'lsa vergul bilan: 123456789,987654321
ADMIN_IDS=123456789

# Jadval bo'yicha post ketadigan vaqt (cron format)
# "0 9 * * *"  = har kuni soat 09:00
# "0 9,21 * * *" = har kuni 09:00 va 21:00
# "0 */3 * * *"  = har 3 soatda
SCHEDULE_CRON=0 9 * * *

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Mos avto-javob pilmasa nima deb javob bersin
JAVOB_TOPILMADI=Savolingizni oldik! Tez orada javob beramiz. 🙏

# Google Gemini AI API kaliti (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-google-gemini-api-key-here
